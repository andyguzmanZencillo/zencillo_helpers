{
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.fixAll": "always"
    },
  
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Dart-Code.dart-code",
  
    "[dart]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "Dart-Code.dart-code",
      "editor.codeActionsOnSave": {
        "source.organizeImports": "always",
        "source.fixAll": "always"
      }
    },
    "[sql]": {
      "editor.defaultFormatter": "inferrinizzard.prettier-sql-vscode",
      "editor.formatOnSave": true
    },
  
    "Prettier-SQL.SQLFlavourOverride": "transactsql",
    "Prettier-SQL.keywordCase": "upper",
    "dart.vmAdditionalArgs": ["--old_gen_heap_size=4096"],
  
    "files.watcherExclude": {
      "**/build/**": true,
      "**/.dart_tool/**": true,
      "**/.git/**": true,
      "**/ios/Pods/**": true,
      "**/android/.gradle/**": true,
      "**/android/build/**": true,
      "**/android/app/build/**": true,
      "**/windows/flutter/ephemeral/**": true,
      "**/linux/flutter/ephemeral/**": true,
      "**/macos/Flutter/ephemeral/**": true
    },
  
    "search.exclude": {
      "**/build/**": true,
      "**/.dart_tool/**": true,
      "**/ios/Pods/**": true,
      "**/android/.gradle/**": true,
      "**/android/build/**": true,
      "**/android/app/build/**": true
    },
  
    "dart.analysisExcludedFolders": [
      "build",
      ".dart_tool",
      "android/.gradle",
      "android/build",
      "android/app/build",
      "ios/Pods",
      "windows/flutter/ephemeral",
      "linux/flutter/ephemeral",
      "macos/Flutter/ephemeral"
    ],
    
  
  }